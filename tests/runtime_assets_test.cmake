cmake_minimum_required(VERSION 3.20)
foreach(required TEST_ROOT ASSET_MODULE GENERATOR C_COMPILER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing test argument: ${required}")
    endif()
endforeach()
string(TIMESTAMP run "%Y%m%d%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(source "${TEST_ROOT}/${run}-${suffix}/source")
set(binary "${TEST_ROOT}/${run}-${suffix}/build")
file(MAKE_DIRECTORY "${source}/assets/ui")
file(WRITE "${source}/main.c" "int main(void) { return 0; }\n")
file(WRITE "${source}/assets/ui/menu.rcss" "initial")
file(WRITE "${source}/assets/unchanged.bin" "unchanged")
file(WRITE "${source}/assets/ui/字體測試.txt" "UTF-8 asset")
set(project [=[
cmake_minimum_required(VERSION 3.20)
project(RuntimeAssetFixture C)
include("@ASSET_MODULE@")
add_executable(asset_fixture main.c)
tiny_stage_runtime_assets(asset_fixture "${CMAKE_CURRENT_SOURCE_DIR}/assets")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/fixture-$<CONFIG>.txt" CONTENT "$<TARGET_FILE:asset_fixture>")
]=])
string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${source}/CMakeLists.txt" "${project}")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${errors}")
    endif()
endfunction()
set(configure "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G "${GENERATOR}"
    "-DCMAKE_C_COMPILER=${C_COMPILER}" -DCMAKE_BUILD_TYPE=Release)
if(DEFINED MAKE_PROGRAM AND NOT MAKE_PROGRAM STREQUAL "")
    list(APPEND configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
run(${configure})
set(build "${CMAKE_COMMAND}" --build "${binary}" --config Release --target asset_fixture)
run(${build})
file(READ "${binary}/fixture-Release.txt" executable)
get_filename_component(output_dir "${executable}" DIRECTORY)
set(staged "${output_dir}/assets")
set(stamp "${binary}/runtime-assets/asset_fixture/Release/staged.stamp")
file(SHA256 "${executable}" original_hash)
file(TIMESTAMP "${executable}" original_time "%s")
file(TIMESTAMP "${staged}/unchanged.bin" untouched_time "%s")
function(check_executable)
    file(SHA256 "${executable}" hash)
    file(TIMESTAMP "${executable}" timestamp "%s")
    if(NOT hash STREQUAL original_hash OR NOT timestamp STREQUAL original_time)
        message(FATAL_ERROR "Asset-only build relinked the executable")
    endif()
endfunction()
function(check_content path expected)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing staged file: ${path}")
    endif()
    file(READ "${path}" value)
    if(NOT value STREQUAL expected)
        message(FATAL_ERROR "Wrong staged content: ${path}")
    endif()
endfunction()
check_content("${staged}/ui/menu.rcss" "initial")
check_content("${staged}/ui/字體測試.txt" "UTF-8 asset")
file(TIMESTAMP "${stamp}" first_stamp "%s")
run("${CMAKE_COMMAND}" -E sleep 1.1)
run(${build})
file(TIMESTAMP "${stamp}" second_stamp "%s")
if(NOT first_stamp STREQUAL second_stamp)
    message(FATAL_ERROR "No-op build repeated asset staging")
endif()
file(WRITE "${source}/assets/ui/menu.rcss" "updated stylesheet")
run(${build})
check_content("${staged}/ui/menu.rcss" "updated stylesheet")
check_executable()
file(TIMESTAMP "${staged}/unchanged.bin" after_time "%s")
if(NOT after_time STREQUAL untouched_time)
    message(FATAL_ERROR "Unchanged asset was rewritten")
endif()
run("${CMAKE_COMMAND}" -E sleep 1.1)
file(WRITE "${source}/assets/ui/new icon.txt" "new asset")
run(${build})
check_content("${staged}/ui/new icon.txt" "new asset")
check_executable()
run("${CMAKE_COMMAND}" -E sleep 1.1)
file(RENAME "${source}/assets/ui/new icon.txt" "${source}/assets/ui/New Icon.txt")
run(${build})
check_content("${staged}/ui/New Icon.txt" "new asset")
check_executable()
file(WRITE "${staged}/keep-local.txt" "unowned")
run("${CMAKE_COMMAND}" -E sleep 1.1)
file(REMOVE "${source}/assets/ui/New Icon.txt")
file(REMOVE "${source}/assets/ui/字體測試.txt")
run(${build})
if(EXISTS "${staged}/ui/New Icon.txt")
    message(FATAL_ERROR "Deleted source asset survived staging")
endif()
if(EXISTS "${staged}/ui/字體測試.txt")
    message(FATAL_ERROR "Deleted UTF-8 asset survived staging")
endif()
check_content("${staged}/keep-local.txt" "unowned")
check_executable()
run("${executable}")
file(WRITE "${output_dir}/outside.txt" "must survive")
set(owned "${binary}/runtime-assets/asset_fixture/Release/owned.txt")
file(WRITE "${owned}" "../outside.txt")
get_filename_component(module_dir "${ASSET_MODULE}" DIRECTORY)
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE_DIR=${source}/assets" "-DDESTINATION_DIR=${staged}"
    "-DFILES_MANIFEST=${binary}/runtime-assets/asset_fixture/files.txt"
    "-DOWNED_MANIFEST=${owned}" "-DSTAMP=${stamp}"
    -P "${module_dir}/StageRuntimeAssets.cmake"
    RESULT_VARIABLE unsafe_result OUTPUT_VARIABLE unsafe_output ERROR_VARIABLE unsafe_error)
if(unsafe_result EQUAL 0 OR NOT unsafe_error MATCHES "escapes staging directory")
    message(FATAL_ERROR "Unsafe ownership manifest was not rejected: ${unsafe_error}")
endif()
check_content("${output_dir}/outside.txt" "must survive")
message(STATUS "Runtime assets: clean staging, no-op, edit/add/rename/delete, ownership and executable linkage passed")
