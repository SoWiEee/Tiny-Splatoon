 float rand( const in vec2 uv ) {
	const  float a = 12.9898, b = 78.233, c = 43758.5453;
	 float dt = dot( uv.xy, vec2( a,b ) ), sn = mod( dt, PI );
	return fract( sin( sn ) * c );
}
