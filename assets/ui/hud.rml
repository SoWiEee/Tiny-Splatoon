<rml>
<head><title>Tiny Splatoon</title><link type="text/rcss" href="game.rcss" /><link type="text/rcss" href="results-reference.rcss" /><link type="text/rcss" href="map-reference.rcss" /></head>
<body id="hud" class="hud">
  <div class="hud-top"><span id="stage-name" class="stage-name"></span><span id="pause-hint" class="pause-hint">Esc 暫停</span></div>
  <div id="battle-top" class="battle-top">
    <div class="squad squad-own"><div id="squad-a-count" class="squad-count"></div><div id="squad-a" class="squad-slots"></div></div>
    <div id="clock" class="clock">03:00</div>
    <div class="squad squad-enemy"><div id="squad-b-count" class="squad-count"></div><div id="squad-b" class="squad-slots"></div></div>
  </div>
  <div id="team-score" class="team-score"><span id="score-a" class="team-a">0.0%</span><span class="score-divider">／</span><span id="score-b" class="team-b">0.0%</span></div>
  <div id="zones-hud" class="zones-hud hidden">
    <div class="zones-counts">
      <div class="zone-team zone-team-a"><span id="zone-team-a-name">我方</span><strong id="zone-count-a">100</strong><small>計數</small><span class="zone-penalty">罰則 <strong id="zone-penalty-a">0</strong></span></div>
      <div class="zones-divider">／</div>
      <div class="zone-team zone-team-b"><span id="zone-team-b-name">對方</span><strong id="zone-count-b">100</strong><small>計數</small><span class="zone-penalty">罰則 <strong id="zone-penalty-b">0</strong></span></div>
    </div>
    <div class="zone-meta-row"><div class="zone-meta-group"><strong id="zone-objective">中央區</strong><span id="zone-owner">尚未控制</span></div><div class="zone-meta-group zone-phase-group"><strong id="zone-phase">區域輪替</strong><span id="zone-phase-detail"></span></div></div>
    <div id="zones-active" class="zones-active"></div>
    <div id="zone-callout" class="zone-callout hidden" aria-live="polite"></div>
  </div>
  <div id="boss" class="boss hidden"><img id="boss-emblem" class="boss-emblem" src="markers/boss.png"/><div class="boss-main"><div class="boss-heading"><strong>破艦巨獸</strong><span id="boss-phase"></span></div><div class="boss-track"><div id="boss-fill"></div><i class="boss-notch notch-two"></i><i class="boss-notch notch-three"></i></div><div class="boss-detail"><span id="boss-move"></span><span id="boss-state"></span></div></div><strong id="boss-hp" class="boss-percent"></strong></div>
  <div id="minimap" class="minimap"><div id="minimap-heading" class="minimap-heading"><span class="minimap-key">TAB</span><strong>地圖</strong><span id="terrain-status"></span></div><div class="map-surface"><img id="minimap-render" src="native-map"/><div id="minimap-map" class="minimap-map"></div></div><div id="position-status" class="position-status"><span id="position-team-coverage"></span></div><div id="jump-map-help" class="jump-map-help"></div><div id="jump-map-queue" class="jump-map-queue"></div><div id="jump-map-legend" class="jump-map-legend"></div></div>
  <div id="fps" class="fps">影格 <strong id="fps-value">60</strong></div>
  <div id="ally-markers" class="ally-markers"></div>
  <div id="death-markers" class="death-markers"></div>
  <div class="player-info"><div class="player-bars"><span>生命 <strong id="hp">100</strong></span></div><div id="special-meter" class="special-meter"><div id="special-fill"></div></div><span id="special-status" class="special-status"></span></div>
  <div id="ink-gauge" class="ink-gauge" role="meter" aria-label="剩餘墨量" aria-valuemin="0" aria-valuemax="100"><ink-tank id="ink-tank"></ink-tank><span id="ink" class="hidden">100</span><span id="ink-low" class="ink-low hidden">墨量不足</span></div>
  <div id="player-status" class="player-status"></div><weapon-reticle id="reticle" class="reticle"></weapon-reticle>
  <div id="battle-hud-layer" class="battle-hud-layer">
    <battle-feedback id="battle-feedback" class="battle-feedback"></battle-feedback>
    <div id="special-display" class="special-display"><special-gauge id="special-orb" class="special-orb" role="meter" aria-label="特殊技能"></special-gauge><img id="special-art" class="special-art" src="equipment/special-slam.png"/><img id="sub-art" class="sub-art" src="equipment/sub-bomb.png"/><strong id="special-percent" class="special-percent">0%</strong></div>
    <div class="personal-turf"><strong id="personal-score">0 p</strong><span id="turf-pop" class="turf-pop hidden"></span></div>
    <div id="equipment-denied" class="equipment-denied hidden" aria-live="polite"></div>
    <div id="kill-feed" class="kill-feed" aria-live="polite"></div><div id="kill-cards" class="kill-cards" aria-live="polite"></div>
    <div id="battle-callout" class="battle-callout hidden" aria-live="polite"></div>
    <div id="death-card" class="death-card hidden"><img id="death-weapon" class="death-weapon" src="weapons/squid.png"/><div class="death-description"><strong id="death-by">遭到擊倒</strong><span id="death-cause"></span><small id="respawn-hint"></small></div><div class="death-respawn"><hud-ring id="death-ring"></hud-ring><strong id="respawn-seconds">5</strong><span>復活倒數</span></div></div>
    <div id="intro-lineup" class="intro-lineup hidden"></div><div id="battle-banner" class="battle-banner hidden"></div><div id="final-countdown" class="final-countdown hidden"></div>
  </div>
  <div id="pause" class="overlay hidden">
    <div class="dialog pause-dialog">
      <h1 id="pause-title">已暫停</h1><p id="pause-description" class="intro">準備好後，繼續這場對戰。</p>
      <button id="resume" class="primary">繼續遊戲</button>
      <div id="practice-tools" class="practice-tools hidden">
        <button id="practice-gear">更換裝備與外觀　L</button>
        <button id="practice-reset">清除墨水並重設</button>
        <button id="practice-fill">補滿墨量與特殊</button>
        <button id="practice-spawn">返回生點</button>
        <button id="practice-stage">更換場地</button>
      </div>
      <button id="pause-settings">設定</button><button id="pause-howto">操作說明</button>
      <button id="return-menu">返回選單</button><button id="pause-close" class="quiet">離開遊戲</button>
    </div>
    <div id="leave-confirm" class="dialog leave-dialog hidden">
      <h1 id="leave-title">離開這場對戰？</h1><p id="leave-description" class="intro">目前進度不會結算，確定要返回選單嗎？</p>
      <button id="leave-stay">繼續遊玩</button><button id="leave-yes" class="primary">離開對戰</button>
    </div>
  </div>
  <div id="results" class="overlay results-overlay hidden">
    <div class="result-edge"></div><div class="result-scrim"></div>
    <div class="result-head">
      <div id="result-splat" class="result-splat"><i></i><i></i><i></i><i></i></div>
      <h1 id="result-title">VICTORY!</h1><p id="result-detail"></p>
    </div>
    <div id="result-medals" class="result-medals"></div>
    <div id="results-preview" class="results-preview" aria-label="結果展示"></div>
    <div id="result-body" class="result-body">
      <div id="result-boss" class="result-boss hidden"><img id="result-boss-emblem" src="markers/boss.png"/><div class="result-boss-main"><div class="result-boss-heading"><strong>破艦巨獸</strong><span id="result-boss-phase"></span><strong id="result-boss-hp"></strong></div><div class="result-boss-track"><div id="result-boss-fill"></div><i class="boss-notch notch-two"></i><i class="boss-notch notch-three"></i></div></div><div class="result-boss-clock"><small>經過時間</small><strong id="result-boss-time"></strong></div><strong id="result-boss-stamp"></strong></div>
      <div id="result-score" class="result-score">
        <div class="result-score-names"><span id="result-score-a-name"></span><span id="result-score-b-name"></span></div>
        <div class="result-score-track"><div id="result-score-a-fill"></div><div id="result-score-b-fill"></div><div class="result-score-center"></div></div>
      </div>
      <div id="results-table" class="results-table"></div>
      <div class="result-footer">
        <div id="result-xp" class="result-xp"><div class="result-level">等級 <strong id="result-level-value">1</strong></div><div class="result-xp-main"><div class="result-xp-row"><strong id="result-xp-label">+0 XP</strong><span id="result-xp-next"></span></div><div class="result-xp-track" aria-hidden="true"><div id="result-xp-fill"></div></div><div id="result-xp-breakdown" class="result-xp-breakdown"></div></div></div>
        <div class="result-actions"><button id="results-rematch" class="primary">↻　再戰一場</button><button id="results-menu">〈　返回選單</button><button id="results-close">離開遊戲</button></div>
      </div>
    </div>
    <button id="result-skip" class="result-skip" aria-label="略過結果動畫"></button>
    <div class="result-prompts"><span>Enter</span> 略過・選擇　 <span>←</span><span>→</span> 移動</div>
  </div>
</body>
</rml>
