cmake_minimum_required(VERSION 3.20)
foreach(required SOURCE_DIR DESTINATION_DIR FILES_MANIFEST OWNED_MANIFEST STAMP)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing runtime asset staging argument: ${required}")
    endif()
endforeach()
get_filename_component(source "${SOURCE_DIR}" REALPATH)
file(MAKE_DIRECTORY "${DESTINATION_DIR}")
get_filename_component(destination "${DESTINATION_DIR}" REALPATH)
cmake_path(IS_PREFIX source "${destination}" NORMALIZE inside_source)
cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
if(inside_source OR contains_source)
    message(FATAL_ERROR "Runtime assets must stage outside the source asset tree")
endif()
file(STRINGS "${FILES_MANIFEST}" current ENCODING UTF-8)
set(previous)
if(EXISTS "${OWNED_MANIFEST}")
    file(STRINGS "${OWNED_MANIFEST}" previous ENCODING UTF-8)
endif()
# Only files recorded by an earlier successful staging run may be removed.
foreach(relative IN LISTS current previous)
    if(IS_ABSOLUTE "${relative}")
        message(FATAL_ERROR "Absolute asset path in manifest: ${relative}")
    endif()
    set(candidate "${destination}/${relative}")
    get_filename_component(absolute "${candidate}" REALPATH)
    # cmake_path's Windows conversion can abort on Unicode asset filenames.
    set(root_prefix "${destination}/")
    set(candidate_prefix "${absolute}/")
    if(WIN32)
        string(TOLOWER "${root_prefix}" root_prefix)
        string(TOLOWER "${candidate_prefix}" candidate_prefix)
    endif()
    string(FIND "${candidate_prefix}" "${root_prefix}" contained_at)
    if(NOT contained_at EQUAL 0 OR "${absolute}" STREQUAL "${destination}")
        message(FATAL_ERROR "Asset path escapes staging directory: ${relative}")
    endif()
endforeach()
# Remove obsolete names first, including case-only renames on Windows.
foreach(relative IN LISTS previous)
    if(NOT relative IN_LIST current)
        if(IS_DIRECTORY "${destination}/${relative}")
            message(FATAL_ERROR "Expected an owned asset file, found a directory: ${relative}")
        endif()
        file(REMOVE "${destination}/${relative}")
    endif()
endforeach()
foreach(relative IN LISTS current)
    if(NOT EXISTS "${source}/${relative}" OR IS_DIRECTORY "${source}/${relative}")
        message(FATAL_ERROR "Runtime asset is missing: ${relative}")
    endif()
    get_filename_component(parent "${destination}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY "${source}/${relative}" DESTINATION "${parent}")
endforeach()
get_filename_component(state_dir "${OWNED_MANIFEST}" DIRECTORY)
file(MAKE_DIRECTORY "${state_dir}")
file(READ "${FILES_MANIFEST}" manifest)
file(WRITE "${OWNED_MANIFEST}" "${manifest}")
file(TOUCH "${STAMP}")
